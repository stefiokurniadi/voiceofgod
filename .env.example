# Public origin used in the listener QR code. Browsers only allow the
# operator microphone on HTTPS (localhost is the exception).
PUBLIC_BASE_URL=https://captions.example.org

REDIS_URL=redis://valkey:6379/0
REQUIRE_REDIS=true

VLLM_BASE_URL=http://translator:8000/v1
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct
REQUIRE_TRANSLATOR=true

WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
MODEL_DIR=/models

MAX_LIVE_SESSIONS=4
ALLOW_FAKE_MODELS=false

# Postgres. This laptop's PostgreSQL listens on 5433. Compose uses the postgres
# service and overrides DATABASE_URL, so POSTGRES_PASSWORD is what Compose needs.
# Create the database and the login yourself. voiceofgod_test is only for pytest.
DATABASE_URL=postgresql://voiceofgod:password@127.0.0.1:5433/voiceofgod
TEST_DATABASE_URL=postgresql://voiceofgod:password@127.0.0.1:5433/voiceofgod_test
POSTGRES_PASSWORD=

# First start only. Once an admin exists, change the password on /admin.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Paid Google path. Leave these empty to keep local Whisper and vLLM.
# GOOGLE_API_KEY is used for Speech-to-Text v1 and Text-to-Speech.
# Chirp 3 rejects an API key. This organization also blocks service-account keys.
# Sign in with: gcloud auth application-default login
# Then point the line below at the file that command writes.
# GEMINI_API_KEY must be a paid key. The free tier may use the sermon for training.
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_SPEECH_REGION=us
GOOGLE_SPEECH_MODEL=chirp_3
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
TTS_VOICE_EN=en-US-Wavenet-D
TTS_VOICE_ID=id-ID-Wavenet-B

# OBS RTMP ingest. Leave RTMP_AUTH_SECRET empty to keep the browser microphone only.
# RTMP_PUBLIC_URL is the server OBS is given. MEDIAMTX_RTMP_URL is how this
# process pulls audio. In Docker Compose the API overrides MEDIAMTX_RTMP_URL.
# Use letters and numbers for both secrets. RTMP_AUTH_URL is for MediaMTX.
RTMP_PUBLIC_URL=rtmp://127.0.0.1:1935
MEDIAMTX_RTMP_URL=rtmp://127.0.0.1:1935
RTMP_AUTH_SECRET=
RTMP_READ_PASSWORD=
RTMP_AUTH_URL=http://127.0.0.1:8080/internal/rtmp-auth/same-letters-and-numbers-as-RTMP_AUTH_SECRET
